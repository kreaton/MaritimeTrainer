<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console project: compiles the app's model code (no Blazor) straight from the app, needs no NuGet packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MaritimeTrainer.Tests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/MaritimeTrainer/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
